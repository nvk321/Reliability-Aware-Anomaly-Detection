flowchart TD
    subgraph INPUT["Input Multivariate Window"]
        W["Sliding Window Tensor W_t in R^(B x L x M)<br/>B = Batch Size (64), L = Window Length (60), M = Sensors (51)"]
    end

    subgraph TEMPORAL["Temporal Representation Block"]
        PERM["Permute & Reshape to (B*M, 1, L)"]
        CONV1["Conv1D Layer 1: 1 -> 64 filters, kernel=3, padding='same'"]
        RELU1["ReLU Activation"]
        CONV2["Conv1D Layer 2: 64 -> 64 filters, kernel=3, dilation=2, padding='same'"]
        SKIP["Residual Skip Connection: H_conv = ReLU(Conv2) + Conv1"]
        POOL["Temporal Feature Projection: Linear(64 -> 32)"]
        H_TEMP["Temporal Latent Matrix: H_temp in R^(B x M x 32)"]
        
        W --> PERM --> CONV1 --> RELU1 --> CONV2 --> SKIP --> POOL --> H_TEMP
    end

    subgraph GRAPH["Sensor Graph Attention Dependency Block"]
        EMBED["Learnable Node Embeddings: E_1, E_2 in R^(M x 32)"]
        SIM["Raw Directed Similarity: S = ReLU(E_1 * E_2^T)"]
        MASK["Mask Self-Loops: diag(S) = 0"]
        TOPK["Top-K Sparsification (K = 15 strongest physical neighbors)"]
        SOFTMAX["Softmax Normalization over Incoming Edges: A_ij = Softmax(TopK(S))"]
        MP["Message Passing: H_spat = A * H_temp in R^(B x M x 32)"]

        H_TEMP --> MP
        EMBED --> SIM --> MASK --> TOPK --> SOFTMAX --> MP
    end

    subgraph FORECAST["Dual-Perspective Forecasting Head"]
        CONCAT["Joint Spatio-Temporal Concat: [H_temp || H_spat] in R^(B x M x 64)"]
        MLP["Feed-Forward Head: Linear(64 -> 64) -> ReLU -> Dropout(0.2) -> Linear(64 -> 1)"]
        PRED["Forecast Vector: X_hat(t) in R^(B x M)"]

        H_TEMP --> CONCAT
        MP --> CONCAT --> MLP --> PRED
    end

    subgraph SRM_BLOCK["Sensor Reliability Module (SRM)"]
        CURR["Observed Sensor Vector X(t) = W_t[:, -1, :]"]
        ERR["Absolute Prediction Residual: e_i(t) = |x_i(t) - x_hat_i(t)|"]
        NORM_ERR["MAD-Normalized Residual: z_i(t) = (e_i - Med_i) / (MAD_i + eps)"]
        
        SIG1["1. Temporal Volatility v_i(t): Rate-of-change + Stuck Variance Check"]
        SIG2["2. Graph Neighbor Consensus c_i(t): Consistency with Physical Neighbors"]
        SIG3["3. Tail Confidence p_i(t): Gaussian Tail Probability of z_i(t)"]
        
        FUSE["Calibrated Evidential Fusion:<br/>r_i(t) = sigmoid(w_v*logit(v_i) + w_c*logit(c_i) + w_p*logit(p_i) + b_r)"]
        REL_VEC["Reliability Vector: r(t) in [0, 1]^M"]

        CURR --> ERR
        PRED --> ERR --> NORM_ERR
        W --> SIG1
        CURR --> SIG2
        SOFTMAX --> SIG2
        NORM_ERR --> SIG3
        SIG1 --> FUSE
        SIG2 --> FUSE
        SIG3 --> FUSE --> REL_VEC
    end

    subgraph OUTPUTS["Diagnostic System Outputs"]
        S_SYS["Reliability-Weighted System Score:<br/>S_sys(t) = sum_i(r_i * z_i) / (sum_i(r_i) + eps)"]
        S_FAULT["Sensor Fault Localization Score:<br/>S_fault(t) = max_i [ (1 - r_i) * z_i ]"]
        ARGMAX["Degraded Sensor ID = argmax_i [ (1 - r_i) * z_i ]"]

        NORM_ERR --> S_SYS
        REL_VEC --> S_SYS
        NORM_ERR --> S_FAULT
        REL_VEC --> S_FAULT --> ARGMAX
    end

    style INPUT fill:#f8f9fa,stroke:#343a40,stroke-width:2px
    style TEMPORAL fill:#e7f5ff,stroke:#1c7ed6,stroke-width:2px
    style GRAPH fill:#f3f0ff,stroke:#7048e8,stroke-width:2px
    style FORECAST fill:#fff4e6,stroke:#f76707,stroke-width:2px
    style SRM_BLOCK fill:#ebfbee,stroke:#2b8a3e,stroke-width:2px
    style OUTPUTS fill:#fff9db,stroke:#f59f00,stroke-width:2px
